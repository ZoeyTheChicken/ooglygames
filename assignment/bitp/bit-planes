    <script>
      // Some sites embed this page in an iframe and pass the game off as their
      // own. Spot a foreign framing ancestor before the first paint: the page
      // then shows nothing but the banner (see the html.embedded rules), and
      // main() refuses to boot the game.
      (function () {
        if (window.self === window.top) return
        try {
          // A same-origin parent is us — our own pages may frame the game.
          if (window.top.location.href) return
        } catch (e) {
        }

        function ours(url) {
          var host = (url.split('/')[2] || '').split(':')[0]
          return /(^|\.)medv\.io$/.test(host) || host === 'localhost' || host === '127.0.0.1'
        }

        var origins = location.ancestorOrigins
        var foreign = true
        if (origins && origins.length) {
          foreign = false
          for (var i = 0; i < origins.length; i++) {
            if (!ours(origins[i])) foreign = true
          }
        } else if (document.referrer) {
          // Firefox has no ancestorOrigins; the referrer is the framing page.
          foreign = !ours(document.referrer)
        }
        if (foreign) document.documentElement.className += ' embedded'
      })()
    </script>
