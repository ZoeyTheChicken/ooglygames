                />
              </svg>
              TikTok
            </a>
            <a
              class="channel youtube"
              href="https://www.youtube.com/@blobdom"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Blobdom on YouTube"
            >
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"
                />
              </svg>
              YouTube
            </a>
          </div>
        </section>

        
        <section class="coins rise">
          <div>
            <h2 class="head">Buy coins</h2>
            <p>
              Bought coins are yours to keep — get killed and you keep them, log off and they are
              still there next time.
            </p>
            <p class="fine">
              Log in first and leave your username in the note at checkout, so the coins have
              somewhere to go. They are added by hand, so give it a day.
            </p>
          </div>
          <a
            class="buy"
            href="https://buymeacoffee.com/antonmedv/e/565287"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="coin-glyph" aria-hidden="true"></span>
            Buy coins
          </a>
        </section>
